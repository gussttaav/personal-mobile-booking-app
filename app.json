{
  "expo": {
    "name": "personal-mobile-booking-app",
    "slug": "personal-mobile-booking-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "personalmobilebookingapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "dev.gustavoai.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#131315",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.POST_NOTIFICATIONS"]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#131315",
          "dark": {
            "backgroundColor": "#131315"
          }
        }
      ],
      "@react-native-google-signin/google-signin",
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.dev.gustavoai.mobile",
          "enableGooglePay": true
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Permitir que $(PRODUCT_NAME) use Face ID para proteger tu sesión."
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "GustavoAI usa tu calendario para añadir tus clases reservadas."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3a7ad02a-b234-44cc-9688-7b4359f1a226"
      }
    },
    "owner": "gussttaav"
  }
}

{
  "expo": {
    "name": "Gustavo Prof",
    "slug": "personal-mobile-booking-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "personalmobilebookingapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Gustavo usa la cámara para tus clases por video.",
        "NSMicrophoneUsageDescription": "Gustavo usa el micrófono para tus clases por video."
      }
    },
    "android": {
      "package": "dev.gustavoai.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#2a2a2c",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#131315",
          "dark": {
            "backgroundColor": "#131315"
          }
        }
      ],
      "@react-native-google-signin/google-signin",
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.dev.gustavoai.mobile",
          "enableGooglePay": true
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Permitir que $(PRODUCT_NAME) use Face ID para proteger tu sesión."
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "GustavoAI usa tu calendario para añadir tus clases reservadas."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 28
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#4edea3"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3a7ad02a-b234-44cc-9688-7b4359f1a226"
      }
    },
    "owner": "gussttaav",
    "updates": {
      "url": "https://u.expo.dev/3a7ad02a-b234-44cc-9688-7b4359f1a226"
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    }
  }
}

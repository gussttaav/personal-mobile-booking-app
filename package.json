    "@stripe/stripe-react-native": "0.50.3",
    "@supabase/supabase-js": "2.110.0",
    "@zoom/react-native-videosdk": "2.5.10",
    "expo": "~54.0.34",
    "expo-build-properties": "~1.0.10",
    "expo-calendar": "~15.0.8",

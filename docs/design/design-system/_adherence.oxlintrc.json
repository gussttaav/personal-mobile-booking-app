{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "admin-app.jsx",
              "admin-data.js",
              "design-canvas.jsx",
              "feedback-pages.jsx",
              "post-class-review.jsx",
              "src/app/admin/**",
              "src/app/admin/bookings/**",
              "src/app/admin/failed-bookings/**",
              "src/app/admin/payments/**",
              "src/app/admin/students/**",
              "src/app/admin/students/[email]/**",
              "src/components/admin/**",
              "tweaks-panel.jsx",
              "ui_kits/tutoring-platform/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Manrope|Inter))/i]",
        "message": "Font not provided by the design system. Available: Manrope, Inter."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {},
    "tokens": [
